{
  "name": "@adjudicate/red-team",
  "version": "0.2.1",
  "description": "Deterministic adversarial scenario generation (prompt-injection, taint-escalation, tool-scope-violation) that asserts a Pack's kernel-level defenses hold.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/canonical": "workspace:*",
    "@adjudicate/core": "workspace:*"
  },
  "devDependencies": {
    "@adjudicate/pack-cli-agent": "workspace:*",
    "@adjudicate/pack-identity-kyc": "workspace:*",
    "@adjudicate/pack-incident-response": "workspace:*",
    "@adjudicate/pack-payments-pix": "workspace:*",
    "@adjudicate/primitives": "workspace:*",
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
