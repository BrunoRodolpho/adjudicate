{
  "name": "@adjudicate/bench",
  "version": "0.0.8",
  "private": true,
  "description": "Performance characterization benchmarks for @adjudicate/* hot paths. Outputs p50/p95/p99 captured in docs/perf/.",
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run",
    "bench:kernel": "vitest bench --run src/kernel.bench.ts",
    "bench:audit": "vitest bench --run src/audit.bench.ts",
    "report": "tsx src/report.ts",
    "scale": "tsx src/scale/run.ts",
    "scale:audit-bus": "tsx src/scale/run.ts audit-bus-heavy",
    "scale:kill": "tsx src/scale/run.ts kill-heavy",
    "scale:rc": "tsx src/scale/run.ts all --out ../docs/perf/scale-baselines.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/audit": "workspace:*",
    "@adjudicate/pack-payments-pix": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
