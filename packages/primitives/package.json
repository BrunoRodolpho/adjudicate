{
  "name": "@adjudicate/primitives",
  "version": "0.4.1",
  "description": "Layer 2 risk primitives — generic guard + taint factories that two or more Packs already share. Sits between @adjudicate/core (Layer 1, kernel) and per-domain Packs (Layer 3).",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
