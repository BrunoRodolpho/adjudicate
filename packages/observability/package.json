{
  "name": "@adjudicate/observability",
  "version": "0.4.0",
  "description": "OTLP-native observability for @adjudicate — sinks that adapt kernel metrics, learning events, and audit records onto OpenTelemetry signals. Optional plumbing; never affects Decision outcomes.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@adjudicate/core": "workspace:*"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@adjudicate/core": "workspace:*",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
