{
  "name": "@adjudicate/approval-engine",
  "version": "0.3.2",
  "description": "Reference human-approval orchestration for REQUEST_CONFIRMATION flows — pluggable channels (webhook, Slack, Teams, email) + a replay-safe resume via adapter-core confirm().",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/adapter-core": "workspace:*",
    "@adjudicate/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
