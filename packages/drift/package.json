{
  "name": "@adjudicate/drift",
  "version": "0.2.4",
  "description": "Opt-in behavioral/statistical drift detection over the AuditEventBus — running decision-distribution comparison with bounded cardinality. Never touches the decision path.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/core": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
