/**
 * {{packName}} — adjudicate payment Pack.
 *
 * Generated by `adjudicate pack init {{packName}} --template payment`.
 *
 * Exercises five Decision outcomes against a small payment surface:
 * REFUSE (invalid amount), REWRITE (refund > original), ESCALATE (large
 * refund), DEFER (awaiting provider webhook), EXECUTE (happy-path
 * confirm/refund). Customize guards in `./policy.ts` for your domain.
 */

import type { PackV0 } from "@adjudicate/core";
import { {{className}}CapabilityPlanner } from "./capabilities.js";
import { {{className}}PolicyBundle } from "./policy.js";
import {
  PAYMENT_CONFIRMATION_SIGNAL,
  type {{className}}Context,
