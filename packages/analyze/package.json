{
  "name": "@adjudicate/analyze",
  "version": "0.3.0",
  "description": "Static analysis for @adjudicate Packs — Tier 1 metadata-driven analyzers producing AnalysisReport with text/json/SARIF output.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "ts-morph": "^25.0.0"
  },
  "devDependencies": {
    "@adjudicate/pack-payments-pix": "workspace:*",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
