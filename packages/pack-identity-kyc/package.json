{
  "name": "@adjudicate/pack-identity-kyc",
  "version": "0.2.1",
  "description": "adjudicate Pack #3 — Identity/KYC verification with multi-stage DEFER + ESCALATE. Async lifecycle: start → upload → vendor callback. Generated via `adjudicate pack init pack-identity-kyc` (Phase 3a CLI dogfood).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:scenarios": "adjudicate simulate --pack ./dist/index.js --scenarios ./scenarios"
  },
  "files": [
    "dist",
    "scenarios",
    "README.md"
  ],
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/primitives": "workspace:*"
  },
  "devDependencies": {
    "@adjudicate/cli": "workspace:*",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
