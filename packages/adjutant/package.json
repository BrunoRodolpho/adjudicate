{
  "name": "@adjudicate/adjutant",
  "version": "0.2.0",
  "description": "Adjutant — subordinate operations surface that executes adjudicated remediations under supervision with zero independent authority. Turns off-path signals (audit bus, drift, LLM diagnosis) into UNTRUSTED draft envelopes that re-enter the normal adjudicate() path; the kernel decides, the adopter's executor acts.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/adapter-core": "workspace:*",
    "@adjudicate/approval-engine": "workspace:*",
    "@adjudicate/audit": "workspace:*",
    "@adjudicate/core": "workspace:*",
    "@adjudicate/drift": "workspace:*",
    "@adjudicate/pack-incident-response": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
