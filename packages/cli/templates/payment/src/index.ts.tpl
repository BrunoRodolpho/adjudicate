  type {{className}}Payment,
  type {{className}}State,
} from "./types.js";

/**
 * Reconstitute a `{{className}}State` from JSON-serializable form.
 *
 * The runtime state uses `Map<string, Payment>` for `payments`, which
 * doesn't survive `JSON.stringify`. Scenario fixtures + audit replay
 * payloads call this to convert `{ payments: { [id]: Payment } }` back
 * into the Map shape policy guards expect.
 */
export function rehydrate{{className}}State(raw: unknown): {{className}}State {
  if (typeof raw === "object" && raw !== null && "payments" in raw) {
    const payments = (raw as { payments: unknown }).payments;
    if (payments instanceof Map) {
      return { payments: payments as ReadonlyMap<string, {{className}}Payment> };
    }
    if (typeof payments === "object" && payments !== null) {
      return {
        payments: new Map(
          Object.entries(payments as Record<string, {{className}}Payment>),
        ),
      };
    }
  }
  return { payments: new Map() };
}

