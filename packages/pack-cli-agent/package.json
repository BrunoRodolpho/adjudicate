{
  "name": "@adjudicate/pack-cli-agent",
  "version": "0.1.4",
  "description": "Default-deny CLI/terminal agent Pack — composes the shipped command-risk guard with allowlist EXECUTE, credential ESCALATE, maintenance DEFER, and a fail-closed default-deny sink.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/primitives": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
