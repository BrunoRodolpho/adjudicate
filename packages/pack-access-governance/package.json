{
  "name": "@adjudicate/pack-access-governance",
  "version": "0.1.0-experimental",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:scenarios": "node ../cli/dist/bin.js simulate --pack ./dist/index.js --scenarios ./scenarios"
  },
  "files": ["dist", "scenarios", "README.md"],
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/primitives": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.0",
    "fast-check": "^3.23.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
