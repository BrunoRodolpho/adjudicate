{
  "name": "@adjudicate/pack-payments-pix",
  "version": "0.5.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit && eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:scenarios": "adjudicate simulate --pack ./dist/index.js --scenarios ./scenarios"
  },
  "files": [
    "dist",
    "scenarios",
    "README.md"
  ],
  "dependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/primitives": "workspace:*"
  },
  "devDependencies": {
    "@adjudicate/cli": "workspace:*",
    "@adjudicate/eslint-config": "workspace:*",
    "@adjudicate/runtime": "workspace:*",
    "@eslint/eslintrc": "^3.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
