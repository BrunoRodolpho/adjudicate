    "@trpc/server": "^11.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "^15.5.18",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.3.6"
