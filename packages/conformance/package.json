{
  "name": "@adjudicate/conformance",
  "version": "6.0.0",
  "description": "Public Pack conformance harness — runs the kernel's invariant suite (taint protection, replay safety, intent-hash determinism, basis-vocabulary purity, guard ordering, default polarity) against any PackV0.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --outDir dist",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@adjudicate/core": "workspace:*"
  },
  "devDependencies": {
    "@adjudicate/core": "workspace:*",
    "@adjudicate/pack-access-governance": "workspace:*",
    "@adjudicate/pack-cli-agent": "workspace:*",
    "@adjudicate/pack-deployments-approval": "workspace:*",
    "@adjudicate/pack-identity-kyc": "workspace:*",
    "@adjudicate/pack-incident-response": "workspace:*",
    "@adjudicate/pack-payments-pix": "workspace:*",
    "@adjudicate/primitives": "workspace:*",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
